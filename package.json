{
  "name": "@bssyco/jdoc",
  "title": "jDoc",
  "version": "1.1.0",
  "description": "jDoc is a simple and fast framework for building web pages in browser.",
  "main": "./src/jdoc.js",
  "scripts": {
    "js-compile": "rollup -c build/rollup.config.js --sourcemap --bundleConfigAsCjs",
    "js-minify": "uglifyjs --compress typeofs=false --mangle --comments \"/^!/\" --source-map \"content='dist/jDoc.js.map',includeSources,url='jDoc.min.js.map'\" --output dist/jDoc.min.js dist/jDoc.js",
    "build": "npm run js-compile && npm run js-minify",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bssyco/jDoc.git"
  },
  "keywords": [
    "jdoc",
    "javascript",
    "browser",
    "library"
  ],
  "author": {
    "name": "Parviz Taghavi",
    "email": "parviz.taghavi@bssyco.com",
    "url": "https://bssyco.com?lang=en"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./src/*.js": "./src/*.js"
  },
  "bugs": {
    "url": "https://github.com/bssyco/jDoc/issues"
  },
  "homepage": "https://jdoc.bssyco.com/",
  "devDependencies": {
    "eslint": "8.57.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "webpack": "5.102.1"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^8.0.5",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-url": "^8.0.2",
    "@rollup/plugin-virtual": "^3.0.2",
    "autoprefixer": "^10.6.0",
    "babel-plugin-external-helpers": "^6.22.0",
    "babel-plugin-transform-html-import-to-string": "^2.0.0",
    "date-fns": "^4.4.0",
    "font-awesome": "^4.7.0",
    "grunt": "^1.6.3",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-run": "^0.8.1",
    "jquery": "^4.0.0",
    "jqueryui": "^1.11.1",
    "postcss-cli": "^12.0.0",
    "rollup": "^4.63.2",
    "sass": "^1.104.1",
    "string-template": "^1.0.0",
    "uglify-js": "^3.19.3"
  },
  "publishConfig": {
    "ignore": [
      ".github/workflows",
      "CONTRIBUTING.md",
      "test/list-exports"
    ]
  }
}
